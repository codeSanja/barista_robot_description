<?xml version="1.0"?>
<robot name="barista_robot">

    <material name="base_body_color">
        <color rgba="0.3 0.3 0.3 1"/>
    </material>
    <material name="color_8a633a">
        <color rgba="0.541176 0.388235 0.227451 1"/>
    </material>
    <material name="deep_teal_green">
        <color rgba="0.635294 0.141176 0.141176 1"/>
    </material>
    <material name="color_dark_teal_green">
        <color rgba="0.137255 0.529412 0.423529 1"/>
    </material>
    <material name="dark_crimson_red">
        <color rgba="0.576471 0.062745 0.062745 1"/>
    </material>
    <material name="vibrant_purple">
        <color rgba="0.756863 0.054902 0.909804 1"/>
    </material>

    <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
    </material>

    <material name="green_light">
        <color rgba="0.0 1.0 0.0 1"/>
    </material>

    <material name="green_dark">
        <color rgba="0.0 0.5 0.0 1"/>
    </material>

    <material name="blue">
        <color rgba="0.0 0.0 1.0 1"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1"/>
    </material>

    <link name="base_link">
    </link>

    <link name="chassis">
        <inertial>
            <origin xyz="0 0 0.11661564" rpy="0 0 0"/>
            <mass value="2"/>
            <inertia ixx="0.0594855" ixy="0" ixz="0" iyy="0.0583976" iyz="0.00000142499" izz="0.0292619"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.077" rpy="0 0 0"/>
            <geometry><cylinder radius="0.178" length="0.155"/></geometry>
            <material name="base_body_color"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.077" rpy="0 0 0"/>
            <geometry><cylinder radius="0.178" length="0.155"/></geometry>
        </collision>
    </link>

    <joint name="base_link_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="chassis" />
    </joint>



    <!-- Wheel Left -->
    <link name="left_wheel">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.025"/>
            </geometry>
            <material name="green_dark"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.025"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="1.531666666666667e-05" ixy="0" ixz="0" iyy="1.531666666666667e-05" iyz="0" izz="3.0625000000000006e-05"/>
        </inertial>
    </link>

    <gazebo reference="left_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>10.0</mu>
                        <mu2>10.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>10000000.0</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_left_wheel" type="continuous">
        <origin  xyz="0 -0.13 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="left_wheel" />

        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
    </joint>

    <!-- Wheel Right -->
    <link name="right_wheel">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.025"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="1.531666666666667e-05" ixy="0" ixz="0" iyy="1.531666666666667e-05" iyz="0" izz="3.0625000000000006e-05"/>
        </inertial>
    </link>

    <gazebo reference="right_wheel">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>10.0</mu>
                        <mu2>10.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>10000000.0</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_right_wheel" type="continuous">
        <origin xyz="0 0.13 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="right_wheel" />

        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
    </joint>

    <!-- Caster Wheel Front -->
    <link name="front_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="front_yaw_joint" type="continuous">
        <origin  xyz="0.12 0 -0.005" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="front_yaw_link" />

        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
    </joint>

    <link name="front_roll_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="2.7083333333333334e-08" ixy="0" ixz="0" iyy="2.7083333333333334e-08" iyz="0" izz="5.0000000000000004e-08"/>
        </inertial>
    </link>

    <joint name="front_roll_joint" type="continuous">
        <origin  xyz="0 0 0" rpy="0 0 0" />
        <parent link="front_yaw_link" />
        <child link="front_roll_link" />

        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="front_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="green_dark"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="4e-08" ixy="0" ixz="0" iyy="4e-08" iyz="0" izz="4e-08"/>
        </inertial>
    </link>

    <gazebo reference="front_pitch_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.5</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>10000000.0</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="front_pitch_joint" type="continuous">
        <origin  xyz="0 0 0" rpy="0 0 0" />
        <parent link="front_roll_link" />
        <child link="front_pitch_link" />

        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>


    <!-- Caster Wheel Back -->
    <link name="back_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="back_yaw_joint" type="continuous">
        <origin  xyz="-0.12 0 -0.005" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="back_yaw_link" />

        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="back_roll_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="2.7083333333333334e-08" ixy="0" ixz="0" iyy="2.7083333333333334e-08" iyz="0" izz="5.0000000000000004e-08"/>
        </inertial>
    </link>

    <joint name="back_roll_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="back_yaw_link" />
        <child link="back_roll_link" />

        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
    </joint>

    <link name="back_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="green_light"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="4e-08" ixy="0" ixz="0" iyy="4e-08" iyz="0" izz="4e-08"/>
        </inertial>
    </link>

    <gazebo reference="back_pitch_link">
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.5</mu>
                        <mu2>0.5</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>10000000.0</kp>
                        <kd>10000000.0</kd>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="back_pitch_joint" type="continuous">
        <origin  xyz="0 0 0" rpy="0 0 0" />
        <parent link="back_roll_link" />
        <child link="back_pitch_link" />

        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Small central cylinder -->
    <link name="center_base_link">
        <visual>
            <geometry><cylinder radius="0.05" length="0.04"/></geometry>
            <material name="green_light"/>
        </visual>
    </link>
    <joint name="center_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="center_base_link"/>
        <origin xyz="0 0 0.17" rpy="0 0 0"/>
    </joint>

    <!-- Tall central cylinder -->
    <link name="center_column_link">
        <visual>
            <geometry><cylinder radius="0.03" length="0.1"/></geometry>
            <material name="deep_teal_green"/>
        </visual>
    </link>
    <joint name="center_column_joint" type="fixed">
        <parent link="base_link"/>
        <child link="center_column_link"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </joint>


    <!-- Left support rod -->
    <link name="left_support_rod">
        <visual>
            <geometry><cylinder radius="0.02" length="0.22"/></geometry>
            <material name="color_dark_teal_green"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.01" length="0.22"/></geometry>
        </collision>
    </link>
    <joint name="left_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_support_rod"/>
        <origin xyz="0 0.1 0.2" rpy="0 0 0"/>
    </joint>

    <!-- Right support rod -->
    <link name="right_support_rod">
        <visual>
            <geometry><cylinder radius="0.02" length="0.22"/></geometry>
            <material name="color_dark_teal_green"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.01" length="0.22"/></geometry>
        </collision>
    </link>
    <joint name="right_support_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_support_rod"/>
        <origin xyz="0 -0.1 0.2" rpy="0 0 0"/>
    </joint>


    <!-- Upper tray -->
    <link name="tray_link">
        <visual>
            <geometry><cylinder radius="0.16" length="0.09"/></geometry>
            <material name="vibrant_purple"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.16" length="0.09"/></geometry>
        </collision>
    </link>
    <joint name="tray_joint" type="fixed">
        <parent link="base_link"/>
        <child link="tray_link"/>
        <origin xyz="0 0 0.33" rpy="0 0 0"/>
    </joint>


    <!-- PLUGINS -->

    <!-- Joint State Publisher Plugin -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <update_rate>30</update_rate>
            <!-- Publish the state of these joints -->
            <joint_name>joint_left_wheel</joint_name>
            <joint_name>joint_right_wheel</joint_name>
            <joint_name>front_yaw_joint</joint_name>
            <joint_name>back_yaw_joint</joint_name>
            <joint_name>front_roll_joint</joint_name>
            <joint_name>back_roll_joint</joint_name>
            <joint_name>front_pitch_joint</joint_name>
            <joint_name>back_pitch_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- Differential Drive Plugin -->
    <gazebo>
        <plugin
                filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>joint_left_wheel</left_joint>
            <right_joint>joint_right_wheel</right_joint>
            <wheel_separation>0.1</wheel_separation>
            <wheel_radius>0.035</wheel_radius>
            <topic>cmd_vel</topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>

</robot>
