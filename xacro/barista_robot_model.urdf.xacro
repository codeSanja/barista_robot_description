<?xml version="1.0"?>
<robot name="barista_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="include_laser" default="true"/>

    <!-- Assignment dimensions, in metres. -->
    <xacro:property name="wheel_radius" value="0.0352"/>
    <xacro:property name="wheel_width" value="0.0206"/>
    <xacro:property name="rod_width" value="0.02"/>
    <xacro:property name="rod_length" value="0.22"/>

    <!-- Reusable components. -->
    <xacro:include filename="drive_wheel.xacro"/>
    <xacro:include filename="caster_wheel.xacro"/>
    <xacro:include filename="standoff_rod.xacro"/>
    <xacro:include filename="cup_holder_tray.xacro"/>
    <xacro:include filename="laser_scanner.xacro"/>

    <!-- Materials from the original working URDF. -->
    <material name="base_body_color"><color rgba="0.3 0.3 0.3 1"/></material>
    <material name="color_8a633a"><color rgba="0.541176 0.388235 0.227451 1"/></material>
    <material name="deep_teal_green"><color rgba="0.635294 0.141176 0.141176 1"/></material>
    <material name="color_dark_teal_green"><color rgba="0.137255 0.529412 0.423529 1"/></material>
    <material name="dark_crimson_red"><color rgba="0.576471 0.062745 0.062745 1"/></material>
    <material name="vibrant_purple"><color rgba="0.756863 0.054902 0.909804 1"/></material>
    <material name="red"><color rgba="1.0 0.0 0.0 1"/></material>
    <material name="green_light"><color rgba="0.0 1.0 0.0 1"/></material>
    <material name="green_dark"><color rgba="0.0 0.5 0.0 1"/></material>
    <material name="blue"><color rgba="0.0 0.0 1.0 1"/></material>
    <material name="black"><color rgba="0.0 0.0 0.0 1"/></material>
    <material name="white"><color rgba="1.0 1.0 1.0 1"/></material>

    <!-- Main body. -->
    <link name="base_link"/>
    <link name="chassis">
        <inertial>
            <origin xyz="0 0 0.11661564" rpy="0 0 0"/>
            <mass value="2"/>
            <inertia ixx="0.0594855" ixy="0" ixz="0"
                     iyy="0.0583976" iyz="0.00000142499" izz="0.0292619"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.077" rpy="0 0 0"/>
            <geometry><cylinder radius="0.178" length="0.155"/></geometry>
            <material name="base_body_color"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.077" rpy="0 0 0"/>
            <geometry><cylinder radius="0.178" length="0.155"/></geometry>
        </collision>
    </link>
    <joint name="base_link_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="base_link"/>
        <child link="chassis"/>
    </joint>

    <!-- Drive wheels -->
    <xacro:drive_wheel side="left"  y="-0.13"
                       radius="${wheel_radius}" width="${wheel_width}" color="green_dark"/>
    <xacro:drive_wheel side="right" y="0.13"
                       radius="${wheel_radius}" width="${wheel_width}" color="black"/>

    <!-- Caster wheels -->
    <xacro:caster_wheel name="front" x="0.12" pitch_color="green_dark"
                        yaw_friction="false" roll_friction="true"/>
    <xacro:caster_wheel name="back" x="-0.12" pitch_color="green_light"
                        yaw_friction="true" roll_friction="false"/>

    <!-- Four rods -->
    <xacro:standoff_rod name="front_left_support_rod"  x="0.10"  y="0.10"  z="0.20"
                        width="${rod_width}" length="${rod_length}"/>
    <xacro:standoff_rod name="front_right_support_rod" x="0.10"  y="-0.10" z="0.20"
                        width="${rod_width}" length="${rod_length}"/>
    <xacro:standoff_rod name="back_left_support_rod"   x="-0.10" y="0.10"  z="0.20"
                        width="${rod_width}" length="${rod_length}"/>
    <xacro:standoff_rod name="back_right_support_rod"  x="-0.10" y="-0.10" z="0.20"
                        width="${rod_width}" length="${rod_length}"/>

    <xacro:cup_holder_tray radius="0.16" length="0.09" z="0.33"/>

    <!-- Disabled means the link, mesh, joint, and sensor are all absent. -->
    <xacro:if value="$(arg include_laser)">
        <xacro:laser_scanner/>
    </xacro:if>

    <!-- Existing Gazebo systems from the URDF. -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <update_rate>30</update_rate>
            <joint_name>joint_left_wheel</joint_name>
            <joint_name>joint_right_wheel</joint_name>
            <joint_name>front_yaw_joint</joint_name>
            <joint_name>back_yaw_joint</joint_name>
            <joint_name>front_roll_joint</joint_name>
            <joint_name>back_roll_joint</joint_name>
            <joint_name>front_pitch_joint</joint_name>
            <joint_name>back_pitch_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>joint_left_wheel</left_joint>
            <right_joint>joint_right_wheel</right_joint>
            <wheel_separation>0.26</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <topic>cmd_vel</topic>
            <!-- The three legacy publish_* options are retained from your URDF. -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>
</robot>
