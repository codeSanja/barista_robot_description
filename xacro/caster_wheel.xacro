<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Recreates the original three-joint yaw / roll / pitch caster assembly. -->
    <xacro:macro name="caster_wheel"
                 params="name x pitch_color yaw_friction roll_friction">
        <link name="${name}_yaw_link">
            <visual>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><cylinder length="0.01" radius="0.03"/></geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><cylinder length="0.01" radius="0.03"/></geometry>
            </collision>
            <inertial>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <mass value="0.001"/>
                <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0"
                         iyy="5.145833333333334e-09" iyz="0"
                         izz="1.0125000000000003e-08"/>
            </inertial>
        </link>

        <joint name="${name}_yaw_joint" type="continuous">
            <origin xyz="${x} 0 -0.005" rpy="0 0 0"/>
            <parent link="base_link"/>
            <child link="${name}_yaw_link"/>
            <axis xyz="0 0 1"/>
            <limit effort="1000.0" velocity="100.0"/>
            <xacro:if value="${yaw_friction}">
                <dynamics damping="0.0" friction="0.1"/>
            </xacro:if>
        </joint>

        <link name="${name}_roll_link">
            <visual>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><cylinder length="0.01" radius="0.03"/></geometry>
                <material name="red"/>
            </visual>
            <collision>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><cylinder length="0.01" radius="0.03"/></geometry>
            </collision>
            <inertial>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <mass value="0.001"/>
                <inertia ixx="2.7083333333333334e-08" ixy="0" ixz="0"
                         iyy="2.7083333333333334e-08" iyz="0"
                         izz="5.0000000000000004e-08"/>
            </inertial>
        </link>

        <joint name="${name}_roll_joint" type="continuous">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${name}_yaw_link"/>
            <child link="${name}_roll_link"/>
            <axis xyz="1 0 0"/>
            <limit effort="1000.0" velocity="100.0"/>
            <xacro:if value="${roll_friction}">
                <dynamics damping="0.0" friction="0.1"/>
            </xacro:if>
        </joint>

        <link name="${name}_pitch_link">
            <visual>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><sphere radius="0.03"/></geometry>
                <material name="${pitch_color}"/>
            </visual>
            <collision>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry><sphere radius="0.03"/></geometry>
            </collision>
            <inertial>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <mass value="0.001"/>
                <inertia ixx="4e-08" ixy="0" ixz="0"
                         iyy="4e-08" iyz="0" izz="4e-08"/>
            </inertial>
        </link>

        <gazebo reference="${name}_pitch_link">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.5</mu>
                            <mu2>0.5</mu2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>10000000.0</kp>
                            <kd>10000000.0</kd>
                        </ode>
                    </contact>
                </surface>
            </collision>
        </gazebo>

        <joint name="${name}_pitch_joint" type="continuous">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${name}_roll_link"/>
            <child link="${name}_pitch_link"/>
            <axis xyz="0 1 0"/>
            <limit effort="1000.0" velocity="100.0"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>
    </xacro:macro>
</robot>
