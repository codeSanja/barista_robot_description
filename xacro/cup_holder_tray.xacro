<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="cup_holder_tray" params="radius length z">
        <link name="tray_link">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <material name="vibrant_purple"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
            </collision>
        </link>
        <joint name="tray_joint" type="fixed">
            <parent link="base_link"/>
            <child link="tray_link"/>
            <origin xyz="0 0 ${z}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>
