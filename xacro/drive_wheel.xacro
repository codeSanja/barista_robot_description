<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Wheel axis, friction, and joint names match the original working URDF. -->
    <xacro:macro name="drive_wheel" params="side y radius width color">
        <link name="${side}_wheel">
            <visual>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
                <material name="${color}"/>
            </visual>
            <collision>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
            </collision>
            <inertial>
                <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
                <mass value="0.05"/>
                <inertia
                    ixx="${0.05 * (3 * radius * radius + width * width) / 12}"
                    ixy="0" ixz="0"
                    iyy="${0.05 * (3 * radius * radius + width * width) / 12}"
                    iyz="0"
                    izz="${0.05 * radius * radius / 2}"/>
            </inertial>
        </link>

        <gazebo reference="${side}_wheel">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>10.0</mu>
                            <mu2>10.0</mu2>
                        </ode>
                    </friction>
                    <contact>
                        <ode>
                            <kp>10000000.0</kp>
                            <kd>10000000.0</kd>
                        </ode>
                    </contact>
                </surface>
            </collision>
        </gazebo>

        <joint name="joint_${side}_wheel" type="continuous">
            <origin xyz="0 ${y} 0" rpy="0 0 0"/>
            <parent link="base_link"/>
            <child link="${side}_wheel"/>
            <axis xyz="0 1 0"/>
            <limit effort="10000" velocity="1000"/>
        </joint>
    </xacro:macro>
</robot>
